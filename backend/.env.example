# ==============================================================================
# DoodleSync Backend Production & Local Environment Variables
# ==============================================================================

# Server Port (Render / Railway assign this automatically in production)
PORT=5001

# Node Environment ('production' for live deployment, 'development' for local)
NODE_ENV=production

# Frontend Application URL for CORS
# In production on Render/Railway, set this to your Vercel URL (e.g. https://your-app.vercel.app)
# or set to * to allow all domains (including Vercel preview deployments)
CLIENT_URL=https://your-frontend-app.vercel.app
