# ==============================================================================
# DoodleSync Backend Environment Variables Template
# ==============================================================================

# Server Port (Render/Railway dynamically assigns this in production)
PORT=5001

# Node Environment ('development' for local run, 'production' for live deployment)
NODE_ENV=development

# Allowed Frontend URL(s) for CORS & WebSocket connections
# Local Development: http://localhost:5173
# Production: https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173
